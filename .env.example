# ============================================================
# Mnemo — variáveis de ambiente (exemplo)
#
# Copie para .env e preencha os valores. NADA sensível ou real
# deve ser versionado: este arquivo só documenta os nomes.
#
# Uso local:  cp .env.example .env  &&  docker compose up --build
# ============================================================

# --- Banco de dados (PostgreSQL) ---
# Postgres gerenciado pelo Render injeta a connection string via DATABASE_URL.
# Local (docker compose): o serviço `db` usa mnemo/mnemo.
DATABASE_URL=postgresql+psycopg://mnemo:mnemo@db:5432/mnemo

# --- Transcrição (Whisper): tiny | base | small | medium | large ---
WHISPER_MODEL=base

# --- IA / flashcards (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Segurança / upload ---
MAX_UPLOAD_MB=200
# CORS: JSON ou lista separada por vírgula
CORS_ORIGINS=["*"]
# Reservado para endpoints administrativos futuros (não usado hoje)
ADMIN_TOKEN=

# --- Debug / logging ---
DEBUG=false
LOG_LEVEL=INFO

# --- Imagem unificada de produção (nginx + API) ---
# Porta que o nginx escuta (o Render injeta a própria via PORT)
PORT=80
# Endereço da API para o proxy (mesma imagem local por padrão)
API_UPSTREAM=127.0.0.1:8000