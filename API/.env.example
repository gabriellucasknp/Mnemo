# Banco (host "db" = serviço no compose; em AWS vira o endpoint do RDS)
DATABASE_URL=postgresql+psycopg://mnemo:mnemo@db:5432/mnemo

# Whisper: tiny | base | small | medium | large
WHISPER_MODEL=base

# IA / flashcards (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Segurança
MAX_UPLOAD_MB=200

# CORS — origens permitidas na API (JSON ou separadas por vírgula).
# Em produção com nginx mesmo domínio não é exercitado; defina a URL
# do Render se a API for chamada de outro host.
# Ex.: CORS_ORIGINS=["https://mnemo.onrender.com"]
CORS_ORIGINS=["*"]

# Debug (false em produção)
DEBUG=false
LOG_LEVEL=INFO
