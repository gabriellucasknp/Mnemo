# Banco (host "db" = serviço no compose; em AWS vira o endpoint do RDS)
DATABASE_URL=postgresql+psycopg://mnemo:mnemo@db:5432/mnemo

# Whisper: tiny | base | small | medium | large
WHISPER_MODEL=base

# IA / flashcards (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Segurança
MAX_UPLOAD_MB=200

# Token dos endpoints administrativos (POST /api/ml/treinar, /treinar-questoes).
# Vazio = endpoints de treino desabilitados (503). Gere um valor forte em prod.
ADMIN_TOKEN=

# Origens permitidas no CORS, como lista JSON. Vazio/ausente = "*" (só dev).
# Ex.: CORS_ORIGINS=["https://mnemo.onrender.com"]
#CORS_ORIGINS=

# Rate limiting dos endpoints caros (upload/IA). true em produção.
RATE_LIMIT_ENABLED=true

# Debug (false em produção)
DEBUG=false
LOG_LEVEL=INFO
