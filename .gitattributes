# Normaliza finais de linha independente do core.autocrlf de quem clonar.
#
# Sem isto, um clone no Windows (autocrlf=true) traz entrypoint.sh com CRLF e
# o container morre com "bad interpreter: /bin/sh^M" no build local.
* text=auto eol=lf

# Entram no container: têm que ser LF sempre.
*.sh              text eol=lf
deploy/*.template text eol=lf
Dockerfile        text eol=lf
*.dockerignore    text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.conf            text eol=lf

# Scripts do Windows continuam CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários: o git não pode mexer.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.pkl  binary
*.mp3  binary
*.wav  binary
*.m4a  binary
*.ogg  binary

# Reduz ruído de diff em lockfiles gerados.
package-lock.json -diff linguist-generated
